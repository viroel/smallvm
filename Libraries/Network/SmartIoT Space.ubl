module 'SmartIoT Space' Comm
author 'MicroBlocks and Elecfreaks Team'
version 1 1
depends 'Network/WiFi' '_Network/HTTP client'
tags iot cloud internet elecfreaks smartiot network dashboard
choices smartiot_switchMenu 'on' 'off'
description 'Send data to ELECFREAKS SmartIoT and read its switch.
Connect to WiFi first, then connect using the device user token and topic.
Uploads are spaced at least one second apart; switch changes are polled every 500 ms.
Use External HTTP client and External WiFi for an ESP-AT module on a board without WiFi.'
variables _smartiot_spaceConnected _smartiot_spaceSendMsg _smartiot_spaceLastSendTime _smartiot_spaceSwitchListenFlag _smartiot_spaceSwitchStatus _smartiot_spaceSwitchKnown
variables _smartiot_spaceHost _smartiot_spacePort _smartiot_spaceToken _smartiot_spaceTopic _smartiot_spaceLastResponse
variables _smartiot_spaceRequestBusy _smartiot_spaceSwitchLoopHeartbeat
variables _smartiot_spaceListeners _smartiot_spaceNezhaCompatibility

  spec ' ' 'smartiot switch broadcast' 'when SmartIoT switch _ send broadcast _' 'menu.smartiot_switchMenu str' 'on' ''
  spec ' ' 'smartiot connect' 'connect SmartIoT with usertoken _ topic _' 'str str' 'YourUserToken' '1'
  spec ' ' 'smartiot set data' 'set data to send SmartIoT field 1 _ : field 2 _ : field 3 _ : field 4 _ : field 5 _ : field 6 _ : field 7 _ : field 8 _' 'num num num num num num num num' 0 0 0 0 0 0 0 0
  spec ' ' 'smartiot upload' 'upload data to SmartIoT'
  spec 'r' 'smartiot connected' 'SmartIoT connection'
  spec 'r' 'smartiot switch is' 'SmartIoT switch _' 'menu.smartiot_switchMenu' 'on'
  spec ' ' 'smartiot set server' 'set SmartIoT server host _ port _' 'str num' 'http://www.smartiot.space' 8080
  spec 'r' 'smartiot last response' 'SmartIoT last response'
  advanced
  spec 'r' '_smartiot get' '_smartiot get _' 'str' ''
  spec ' ' '_smartiot poll switch' '_smartiot poll switch'
  spec ' ' '_smartiot broadcast loop' '_smartiot broadcast loop'

to '_smartiot_spaceEnsureDefaults' {
  if (_smartiot_spaceHost == 0) {_smartiot_spaceHost = 'http://www.smartiot.space'}
  if (_smartiot_spacePort == 0) {_smartiot_spacePort = 8080}
  if (_smartiot_spaceToken == 0) {_smartiot_spaceToken = ''}
  if (_smartiot_spaceTopic == 0) {_smartiot_spaceTopic = ''}
  if (_smartiot_spaceSendMsg == 0) {_smartiot_spaceSendMsg = ''}
  if (_smartiot_spaceLastResponse == 0) {_smartiot_spaceLastResponse = ''}
}

to '_smartiot_spaceUrl' path {
  '_smartiot_spaceEnsureDefaults'
  return ('[data:join]' _smartiot_spaceHost ':' _smartiot_spacePort path)
}

to '_smartiot_spacePathWithoutLeadingSlash' path {
  if (and ((size path) > 0) ((at 1 path) == '/')) {
    return ('[data:copyFromTo]' path 2)
  }
  return path
}

to '_smartiot_spaceLowercase' string {
  local 'lowercased' ''
  local 'char code' ''
  for c (size string) {
    'char code' = ('[data:unicodeAt]' c string)
    if (and ((v 'char code') >= 65) ((v 'char code') <= 90)) {
      'char code' = ((v 'char code') + 32)
    }
    lowercased = ('[data:join]' lowercased ('[data:unicodeString]' (v 'char code')))
  }
  return lowercased
}

to '_smartiot_spaceDecomposeURL' url {
  local 'host' ''
  local 'path' ''
  local 'auxUrl' ''
  local 'colonPosition' ('[data:find]' '://' url)
  local 'protocol' (ifExpression (('[data:find]' 'https://' ('_smartiot_spaceLowercase' url)) > 0) 'https' (ifExpression (('[data:find]' 'http://' ('_smartiot_spaceLowercase' url)) > 0) 'http' 'https'))
  local 'port' (ifExpression (protocol == 'https') 443 80)
  if (colonPosition > 4) {
    auxUrl = ('[data:copyFromTo]' url (colonPosition + 3))
  } else {
    auxUrl = url
  }
  local 'slashPosition' ('[data:find]' '/' auxUrl)
  if (slashPosition > 0) {
    host = ('[data:copyFromTo]' auxUrl 1 (slashPosition - 1))
    path = ('[data:copyFromTo]' auxUrl (slashPosition + 1))
  } else {
    host = auxUrl
  }
  colonPosition = ('[data:find]' ':' host)
  if (colonPosition > 0) {
    port = ('[data:convertType]' ('[data:copyFromTo]' host (colonPosition + 1)) 'number')
    host = ('[data:copyFromTo]' host 1 (colonPosition - 1))
  }
  return ('[data:makeList]' protocol host path port)
}

to '_smartiot_spaceBodyStart' response {
  return (('[data:find]' ('[data:unicodeString]' ('[data:makeList]' 13 10 13 10)) response) + 4)
}

to '_smartiot_spaceExpectedLength' response {
  if (('_smartiot_spaceBodyStart' response) < 10) {
    return 0
  }
  local 'start' (('[data:find]' 'Content-Length: ' response) + 16)
  if (start < 16) {
    return -1
  }
  local 'end' (('[data:find]' ('[data:unicodeString]' ('[data:makeList]' 13 10)) response start) - 1)
  local 'contentLength' ('[data:convertType]' ('[data:copyFromTo]' response start end) 'number')
  return ((('_smartiot_spaceBodyStart' response) + contentLength) - 1)
}

to '_smartiot_spaceReadHTTPResponse' {
  return ('_readHTTPResponse')
}

to '_smartiot_spaceStatusText' response {
  return ('[data:copyFromTo]' response ('[data:find]' ' ' response) (('[data:find]' ('[data:unicodeString]' ('[data:makeList]' 13 10)) response) - 1))
}

to '_smartiot_spaceStatus' response {
  return (('[data:copyFromTo]' ('_smartiot_spaceStatusText' response) 1 4) + 0)
}

to '_smartiot_spaceResponseOK' response {
  if (('[data:find]' '"code":200' response) > 0) {return true}
  if (('[data:find]' '"code": 200' response) > 0) {return true}
  if (('[data:find]' 'switchOn' response) > 0) {return true}
  if (('[data:find]' 'switchOff' response) > 0) {return true}
  return false
}

to '_smartiot_spaceGETUnlocked' path {
  // Saved Nezha projects retain their original native HTTP behavior.
  if _smartiot_spaceNezhaCompatibility {return ('_smartiot_spaceGETNezha' path)}
  '_smartiot_spaceEnsureDefaults'
  // The selected HTTP transport checks its own WiFi connection (native or ESP-AT).
  local 'hostInfo' ('_smartiot_spaceDecomposeURL' ('_smartiot_spaceUrl' path))
  local 'url' ('[data:join]' (at 2 hostInfo) '/' (at 3 hostInfo))
  local 'response' ('_request_url' url 'GET' '' (at 4 hostInfo) ((at 1 hostInfo) == 'https'))
  if (('[data:find]' '0 ' response) == 1) {
    _smartiot_spaceLastResponse = (at 1 ('[data:split]' response ('[data:unicodeString]' ('[data:makeList]' 13 10))))
  } (response != '') {
    if (('_smartiot_spaceStatus' response) == 200) {
      _smartiot_spaceLastResponse = ('[data:copyFromTo]' response ('_smartiot_spaceBodyStart' response))
    } else {
      _smartiot_spaceLastResponse = ('_smartiot_spaceStatusText' response)
    }
  } else {
    _smartiot_spaceLastResponse = 'Failed to get response'
  }
  return _smartiot_spaceLastResponse
}

to '_smartiot_spaceGET' path {
  '_smartiot_spaceEnsureDefaults'
  local 'lockStart' (millisOp)
  repeatUntil (not _smartiot_spaceRequestBusy) {
    if ((millisSince lockStart) >= 12000) {
      _smartiot_spaceLastResponse = '0 Request Busy'
      return _smartiot_spaceLastResponse
    }
    waitMillis 10
  }
  _smartiot_spaceRequestBusy = true
  local 'result' ('_smartiot_spaceGETUnlocked' path)
  _smartiot_spaceRequestBusy = false
  return result
}

to '_smartiot_spaceStatusPath' {
  return ('[data:join]' '/iot/iotTopic/getTopicStatus/' _smartiot_spaceToken '/' _smartiot_spaceTopic)
}

to '_smartiot_spaceUpdateSwitchFromResponse' response fireEvent {
  local 'newStatus' _smartiot_spaceSwitchStatus
  local 'knownStatus' false
  if (('[data:find]' 'switchOn' response) > 0) {
    newStatus = true
    knownStatus = true
  } (('[data:find]' 'switchOff' response) > 0) {
    newStatus = false
    knownStatus = true
  }
  if knownStatus {
    if (and (and fireEvent _smartiot_spaceSwitchKnown) (newStatus != _smartiot_spaceSwitchStatus)) {
      if newStatus {
        '_smartiot_spaceNotifySwitch' 'on'
      } else {
        '_smartiot_spaceNotifySwitch' 'off'
      }
    }
    _smartiot_spaceSwitchStatus = newStatus
    _smartiot_spaceSwitchKnown = true
  }
}

to 'smartiot connect' userToken topic {
  '_smartiot_spaceEnsureDefaults'
  _smartiot_spaceToken = userToken
  _smartiot_spaceTopic = topic
  _smartiot_spaceConnected = false
  _smartiot_spaceSwitchKnown = false
  repeat 3 {
    local 'response' ('_smartiot_spaceGET' ('_smartiot_spaceStatusPath'))
    if ('_smartiot_spaceResponseOK' response) {
      _smartiot_spaceConnected = true
      '_smartiot_spaceUpdateSwitchFromResponse' response false
      '_smartiot_spaceStartSwitchLoop'
      return
    }
    waitMillis 200
  }
}

to 'smartiot set data' n1 n2 n3 n4 n5 n6 n7 n8 {
  '_smartiot_spaceEnsureDefaults'
  local 'data1' (argOrDefault 1 0)
  local 'data2' (argOrDefault 2 0)
  local 'data3' (argOrDefault 3 0)
  local 'data4' (argOrDefault 4 0)
  local 'data5' (argOrDefault 5 0)
  local 'data6' (argOrDefault 6 0)
  local 'data7' (argOrDefault 7 0)
  local 'data8' (argOrDefault 8 0)
  _smartiot_spaceSendMsg = ('[data:join]' '/iot/iotTopicData/addTopicData?userToken=' _smartiot_spaceToken '&topicName=' _smartiot_spaceTopic '&data1=' data1 '&data2=' data2 '&data3=' data3 '&data4=' data4 '&data5=' data5 '&data6=' data6 '&data7=' data7 '&data8=' data8)
}

to 'smartiot upload' {
  '_smartiot_spaceEnsureDefaults'
  if (not _smartiot_spaceConnected) {return}
  if (_smartiot_spaceSendMsg == 0) {return}
  if ((size _smartiot_spaceSendMsg) == 0) {return}
  if (_smartiot_spaceLastSendTime > 0) {
    local 'elapsed' (millisSince _smartiot_spaceLastSendTime)
    if (elapsed < 1000) {
      waitMillis (1000 - elapsed)
    }
  }
  '_smartiot_spaceGET' _smartiot_spaceSendMsg
  _smartiot_spaceLastSendTime = (millisOp)
}

to 'smartiot connected' {
  return (_smartiot_spaceConnected == true)
}

to '_smartiot_spaceStartSwitchLoop' {
  '_smartiot_spaceEnsureDefaults'
  local 'loopStale' false
  if _smartiot_spaceSwitchListenFlag {
    if (_smartiot_spaceSwitchLoopHeartbeat == 0) {
      loopStale = true
    } else {
      loopStale = ((millisSince _smartiot_spaceSwitchLoopHeartbeat) >= 15000)
    }
  }
  if (or (not _smartiot_spaceSwitchListenFlag) loopStale) {
    _smartiot_spaceSwitchListenFlag = true
    _smartiot_spaceSwitchLoopHeartbeat = (millisOp)
    sendBroadcast '_smartiot_spaceSwitchLoop'
  }
}

to '_smartiot_spaceSwitchLoop' {
  forever {
    _smartiot_spaceSwitchLoopHeartbeat = (millisOp)
    if _smartiot_spaceConnected {
      '_smartiot_spaceUpdateSwitchFromResponse' ('_smartiot_spaceGET' ('_smartiot_spaceStatusPath')) true
    }
    _smartiot_spaceSwitchLoopHeartbeat = (millisOp)
    waitMillis 500
  }
}

to 'smartiot switch broadcast' state message {
  '_smartiot_spaceStartSwitchLoop'
  if (state == '开') {state = 'on'}
  if (state == '关') {state = 'off'}
  if (not (or (state == 'on') (state == 'off'))) {return}
  if (_smartiot_spaceListeners == 0) {_smartiot_spaceListeners = ('[data:makeList]')}
  '[data:addLast]' ('[data:makeList]' state message) _smartiot_spaceListeners
}

to 'smartiot switch is' state {
  local 'isOn' (_smartiot_spaceSwitchStatus == true)
  if (or (state == 'on') (state == '开')) {
    return isOn
  }
  return (not isOn)
}

to 'smartiot set server' host port {
  local 'hostText' ('[data:convertType]' host 'string')
  if ((('[data:find]' '://' hostText) < 1)) {
    hostText = ('[data:join]' 'http://' hostText)
  }
  if (and ((size hostText) > 0) ((at 'last' hostText) == '/')) {
    hostText = ('[data:copyFromTo]' hostText 1 ((size hostText) - 1))
  }
  _smartiot_spaceHost = hostText
  _smartiot_spacePort = port
}

to 'smartiot last response' {
  if (_smartiot_spaceLastResponse == 0) {return ''}
  return _smartiot_spaceLastResponse
}

to '_smartiot_spaceNotifySwitch' state {
  // The legacy board wrapper opts in to the original synchronous firmware events.
  if _smartiot_spaceNezhaCompatibility {
    '[elfreaks:Event_NotifySmartIotSwitch]' state
  }
  if (_smartiot_spaceListeners == 0) {return}
  for listener _smartiot_spaceListeners {
    if ((at 1 listener) == state) {sendBroadcast (at 2 listener)}
  }
}

to '_smartiot get' path {
  return ('_smartiot_spaceGET' path)
}

to '_smartiot poll switch' {
  if _smartiot_spaceConnected {
    '_smartiot_spaceUpdateSwitchFromResponse' ('_smartiot_spaceGET' ('_smartiot_spaceStatusPath')) true
  }
}

to '_smartiot broadcast loop' {
  '_smartiot_spaceStartSwitchLoop'
}


to '_smartiot_spaceGETNezha' path {
  '_smartiot_spaceEnsureDefaults'
  if (('[net:myIPAddress]') == '0.0.0.0') {
    _smartiot_spaceLastResponse = '0 Not Connected'
    return _smartiot_spaceLastResponse
  }
  local 'hostInfo' ('_smartiot_spaceDecomposeURL' ('_smartiot_spaceUrl' path))
  local 'protocol' (at 1 hostInfo)
  local 'host' (at 2 hostInfo)
  local 'requestPath' ('_smartiot_spacePathWithoutLeadingSlash' ('[data:join]' '/' (at 3 hostInfo)))
  local 'port' (at 4 hostInfo)
  if (protocol == 'https') {
    '[net:httpSecureConnect]' host port
  } else {
    '[net:httpConnect]' host port
  }
  if (not ('[net:httpIsConnected]')) {
    _smartiot_spaceLastResponse = '0 Could not connect to server'
    return _smartiot_spaceLastResponse
  }
  '[net:httpRequest]' 'GET' ('[data:join]' host ':' port) requestPath ''
  local 'response' ('_smartiot_spaceReadHTTPResponse')
  if (response != '') {
    if (('_smartiot_spaceStatus' response) == 200) {
      _smartiot_spaceLastResponse = ('[data:copyFromTo]' response ('_smartiot_spaceBodyStart' response))
    } else {
      _smartiot_spaceLastResponse = ('_smartiot_spaceStatusText' response)
    }
  } else {
    _smartiot_spaceLastResponse = 'Failed to get response'
  }
  return _smartiot_spaceLastResponse
}
