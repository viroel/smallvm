module Sport Obsolete
author 'Elecfreaks Team'
version 1 0
description 'Smart Motor
Robot Car Motion Control'

choices MotorPort 'M1' 'M2' 'M3' 'M4'
choices TurnMode 'seconds' 'degrees' 'turns'
choices TurnDirection 'clockwise' 'counterclockwise'
choices TurnDirectionEx 'clockwise' 'counterclockwise' 'shortest path'
choices DriveMode 'seconds' 'mm'
choices DriveDirection 'forward' 'backward'
choices AccelLevel 'low' 'medium' 'high'
choices WaitMode 'no wait' 'wait until done'
choices Weight 'light' 'medium' 'heavy'

spec ' ' 'MotorStart' 'start motor _ speed _ % direction _' 'menu.MotorPort num menu.TurnDirection' 'M1'  50 'clockwise'
spec ' ' 'MotorStop' 'stop motor _' 'menu.MotorPort' 'M1'
space
space
spec ' ' 'MotorReset' 'reset motor _ position : _' 'menu.MotorPort menu.WaitMode' 'M1' 'wait until done'
spec ' ' 'MotorMoveRelativeV2' 'turn motor _ speed _ % direction _ for _ _ : _' 'menu.MotorPort num menu.TurnDirection num menu.TurnMode menu.WaitMode' 'M1' 50 'clockwise' 0 'seconds' 'wait until done'
spec ' ' 'MotorMoveAbsoluteV2' 'turn motor _ speed _ % direction _ to absolute angle _ : _' 'menu.MotorPort num menu.TurnDirectionEx num menu.WaitMode' 'M1' 50 'shortest path' 0 'wait until done'
space
space
spec ' ' 'RobotSetWeight' 'set robot load _' 'menu.Weight' 'medium'
spec ' ' 'RobotSetWheelDiameter' 'set robot wheel diameter _ mm' 'num' 0
spec ' ' 'RobotSetMotors' 'set robot left wheel _ right wheel _' 'menu.MotorPort menu.MotorPort' 'M1' 'M2'
spec ' ' 'RobotMove' 'run robot left wheel speed _ % right wheel speed _ %' 'num num' 0 0
spec ' ' 'RobotTurnToV2' 'turn robot at _ % speed with _ acceleration by _ degrees : _' 'num menu.AccelLevel num menu.WaitMode' 50 'medium' 0 'wait until done'
spec ' ' 'RobotDriveStraightV2' 'drive robot at _ % speed _ with _ acceleration for _ _ : _' 'num menu.DriveDirection menu.AccelLevel num menu.DriveMode menu.WaitMode' 50 'forward' 'medium' 0 'seconds' 'wait until done'
spec ' ' 'RobotStop' 'stop robot'
space
space
spec 'r' 'MotorGetSpeed' 'read motor _ speed (degrees/sec)' 'menu.MotorPort' 'M1'
spec 'r' 'MotorGetAbsoluteAngle' 'read motor _ absolute angle (degrees)' 'menu.MotorPort' 'M1'
spec 'r' 'MotorGetRelativeAngle' 'read motor _ relative angle (degrees)' 'menu.MotorPort' 'M1'

to 'RoundDiv10' value {
  if (value >= 0) {
    return ((value + 5) / 10)
  }
  return ((value - 5) / 10)
}

to 'ParsePort' port_name {
  if (port_name == 'M2') {
    return 1
  } (port_name == 'M3') {
    return 2
  } (port_name == 'M4') {
    return 3
  }
  return 0
}

to 'ParseTurnMode' mode {
  if (mode == 'seconds') {
    return 0
  } (mode == 'degrees') {
    return 1
  } (mode == 'turns') {
    return 2
  }
  return 0
}

to 'ParseTurnDirectionEx' dir {
  if (dir == 'clockwise') {
    return 0
  } (dir == 'counterclockwise') {
    return 1
  } (dir == 'shortest path') {
    return 2
  }
  return 0
}

to 'ParseDriveMode' mode {
  if (mode == 'seconds') {
    return 0
  } (mode == 'mm') {
    return 1
  } (mode == 'cm') {
    return 2
  }
  return 0
}

to 'ParseDriveDirection' dir {
  if (dir == 'forward') {
    return 0
  } (dir == 'backward') {
    return 1
  }
  return 0
}

to 'ParseAccelLevel' accel {
  if (accel == 'low') {
    return 0
  } (accel == 'medium') {
    return 1
  } (accel == 'high') {
    return 2
  }
  return 1
}

to 'ParseWaitMode' mode {
  if (mode == 'no wait') {
    return 0
  } (mode == 'wait until done') {
    return 1
  }
  return 1
}

to 'ParseWeight' mode {
  if (mode == 'light') {
    return 0
  } (mode == 'medium') {
    return 1
  } (mode == 'heavy') {
    return 2
  }
  return 0
}

to 'MotorStart' port speed turn_dir {
  '[display:MotorStart]' ('ParsePort' port) speed ('ParseTurnDirectionEx' turn_dir)
}

to 'MotorStop' port {
  '[display:MotorStop]' ('ParsePort' port)
}

to 'MotorReset' port wait_mode {
  local 'wait' ('ParseWaitMode' wait_mode)
  local 'port_num' ('ParsePort' port)
  '[display:MotorReset]' port_num
  if (wait == 1) {
    repeatUntil (('RoundDiv10' ('[display:MotorGetRelativeAngleDeciDeg]' port_num)) <= 1) {
      waitMillis 10
    }
  }
}

to 'MotorMoveRelativeV2' port speed turn_dir value turn_mode wait_mode {
  // Existing projects use (port, value, mode, speed, direction, wait).
  if (isType turn_dir 'string') {
    if (or (or (turn_dir == 'seconds') (turn_dir == 'degrees')) (turn_dir == 'turns')) {
      local 'oldValue' speed
      local 'oldMode' turn_dir
      speed = value
      turn_dir = turn_mode
      value = oldValue
      turn_mode = oldMode
    }
  }
  local 'wait' ('ParseWaitMode' wait_mode)
  local 'port_num' ('ParsePort' port)
  local 'turn_mode_num' ('ParseTurnMode' turn_mode)
  local 'current' ('RoundDiv10' ('[display:MotorGetRelativeAngleDeciDeg]' port_num))
  if (turn_mode_num == 2) {
    turn_mode_num = 1
    value = (value * 360)
  }
  '[display:MotorMoveRelative]' port_num value turn_mode_num speed ('ParseTurnDirectionEx' turn_dir)
  if (wait == 1) {
    if (turn_mode_num == 0) {
      waitMillis 100
      repeatUntil (('[display:MotorGetSpeed]' port_num) == 0) {
        waitMillis 10
      }
    } else {
      local 'target' (value + current)
      local 'last_angle' current
      local 'same_count' 0
      repeatUntil ((absoluteValue (current - target)) <= 1) {
        waitMillis 10
        current = ('RoundDiv10' ('[display:MotorGetRelativeAngleDeciDeg]' port_num))
        if (current == last_angle) {
          same_count = (same_count + 1)
          if (same_count >= 10) {
            exitLoop
          }
        } else {
          same_count = 0
          last_angle = current
        }
      }
    }
  }
}

// Legacy selector retained for projects saved with the original argument order.
to 'MotorMoveRelative' port value turn_mode speed turn_dir wait_mode {
  'MotorMoveRelativeV2' port speed turn_dir value turn_mode wait_mode
}

to 'MotorMoveAbsoluteV2' port speed turn_dir_ex value wait_mode {
  // Existing projects use (port, angle, speed, direction, wait).
  if (isType turn_dir_ex 'number') {
    local 'oldValue' speed
    speed = turn_dir_ex
    turn_dir_ex = value
    value = oldValue
  }
  local 'wait' ('ParseWaitMode' wait_mode)
  local 'port_num' ('ParsePort' port)
  '[display:MotorMoveAbsolute]' port_num value speed ('ParseTurnDirectionEx' turn_dir_ex)
  if (wait == 1) {
    local 'current' ('RoundDiv10' ('[display:MotorGetAbsoluteAngleDeciDeg]' port_num))
    local 'last_angle' current
    local 'same_count' 0
    repeatUntil ((absoluteValue (current - value)) <= 1) {
      waitMillis 10
      current = ('RoundDiv10' ('[display:MotorGetAbsoluteAngleDeciDeg]' port_num))
      if (current == last_angle) {
        same_count = (same_count + 1)
        if (same_count >= 10) {
          exitLoop
        }
      } else {
        same_count = 0
        last_angle = current
      }
    }
  }
}

// Legacy selector retained for projects saved with the original argument order.
to 'MotorMoveAbsolute' port value speed turn_dir_ex wait_mode {
  'MotorMoveAbsoluteV2' port speed turn_dir_ex value wait_mode
}

to 'MotorGetSpeed' port {
  return ('[display:MotorGetSpeed]' ('ParsePort' port))
}

to 'MotorGetRelativeAngle' port {
  return ('RoundDiv10' ('[display:MotorGetRelativeAngleDeciDeg]' ('ParsePort' port)))
}

to 'MotorGetAbsoluteAngle' port {
  return ('RoundDiv10' ('[display:MotorGetAbsoluteAngleDeciDeg]' ('ParsePort' port)))
}

to 'RobotSetWeight' weight {
  '[display:RobotSetWeight]' ('ParseWeight' weight)
}

to 'RobotSetWheelDiameter' diameter {
  '[display:RobotSetWheelDiameter]' diameter
}

to 'RobotSetMotors' left right {
  '[display:RobotSetMotors]' ('ParsePort' left) ('ParsePort' right)
}

to 'RobotMove' left_speed right_speed {
  '[display:RobotMove]' left_speed right_speed
}

to 'RobotTurnToV2' speed accel angle wait_mode {
  // Existing projects use (angle, speed, acceleration, wait).
  if (isType accel 'number') {
    local 'oldAngle' speed
    speed = accel
    accel = angle
    angle = oldAngle
  }
  local 'wait' ('ParseWaitMode' wait_mode)
  local 'task_id' ('[display:RobotTurnTo]' ('ParseAccelLevel' accel) speed angle)
  if (wait == 1) {
    repeatUntil (('[display:RobotIsIdle]' task_id) == 1) {
      waitMillis 10
    }
  }
}

// Legacy selector retained for projects saved with the original argument order.
to 'RobotTurnTo' angle speed accel wait_mode {
  'RobotTurnToV2' speed accel angle wait_mode
}

to 'RobotDriveStraightV2' speed dir accel value mode wait_mode {
  // Existing projects use (direction, value, mode, speed, acceleration, wait).
  if (isType speed 'string') {
    local 'oldDir' speed
    local 'oldValue' dir
    local 'oldMode' accel
    speed = value
    dir = oldDir
    accel = mode
    value = oldValue
    mode = oldMode
  }
  local 'wait' ('ParseWaitMode' wait_mode)
  local drive_mode_num ('ParseDriveMode' mode)
  if (drive_mode_num == 2) {
    drive_mode_num = 1
    value = (value * 10)
  }
  local 'task_id' ('[display:RobotDriveStraight]' ('ParseDriveDirection' dir) drive_mode_num ('ParseAccelLevel' accel) speed value)
  if (wait == 1) {
    repeatUntil (('[display:RobotIsIdle]' task_id) == 1) {
      waitMillis 10
    }
  }
}

// Legacy selector retained for projects saved with the original argument order.
to 'RobotDriveStraight' dir value mode speed accel wait_mode {
  'RobotDriveStraightV2' speed dir accel value mode wait_mode
}

to 'RobotStop' {
  '[display:RobotStop]'
}

to 'RobotGetYawDeciDeg' {
  return ('RoundDiv10' ('[display:RobotGetYawDeciDeg]'))
}
