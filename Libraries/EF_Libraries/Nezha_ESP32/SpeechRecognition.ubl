module 'Speech Recognition' Obsolete
author 'Elecfreaks Team'
version 1 0
description 'Speech recognition'

choices Language 'CN' 'EN'

spec ' ' 'SR_Enable' 'enable speech recognition _' 'menu.Language' 'CN'
spec ' ' '[io:SR_Disable]' 'disable speech recognition'
spec 'h' 'SR_IsDetected' 'when _ is recognized' 'str' ''

to 'ParseLanguage' language {
    if (or (language == 'CN') (language == '中文')) {
        return 0
    } (or (language == 'EN') (language == '英文')) {
        return 1
    }
    return 0
}

to 'SR_Enable' language {
    '[io:SR_Enable]' ('ParseLanguage' language)
}

to 'SR_IsDetected' str {
    local last_id ('[io:SR_GetEventID]')
    '[io:SR_Register]' str
    forever {
        local id ('[io:SR_GetEventID]')
        if (last_id != id) {
            last_id = id
            if (('[io:SR_IsDetected]' str)) {
                return true
            }
        }
        waitMillis 200
    }
}
